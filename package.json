{
  "name": "exportium-ui",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && tsc -p tsconfig.electron.json && electron .\"",
    "electron:build": "tsc -p tsconfig.electron.json && vite build && electron-builder",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && gradlew assembleDebug",
    "android:bundle": "npm run android:sync && cd android && gradlew bundleRelease",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "node e2e/app.e2e.mjs",
    "test:e2e:desktop": "node e2e/desktop.e2e.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.25",
    "@zip.js/zip.js": "^2.24.0",
    "electron-updater": "^6.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "jszip": "^3.10.2",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.keicei.exportium",
    "productName": "Exportium",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "publish": {
      "provider": "github",
      "owner": "AgastyaSaiN",
      "repo": "Project-Exportium"
    }
  }
}
